# Run in isolated directories: never use the developer's Config.lua or saves.
foreach(scenario syntax runtime log_fallback)
    set(work "${GPP_TEST_DIR}/${scenario}")
    file(MAKE_DIRECTORY "${work}")
    if(scenario STREQUAL "syntax")
        file(WRITE "${work}/Config.lua" "function (")
        set(expected "Cannot load Config.lua")
    else()
        file(WRITE "${work}/Config.lua" "error('startup regression test')")
        set(expected "startup regression test")
    endif()
    if(scenario STREQUAL "log_fallback")
        file(MAKE_DIRECTORY "${work}/Guitar++.log")
    endif()
    execute_process(COMMAND "${GPP_EXECUTABLE}"
        WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors
        TIMEOUT 15)
    if(NOT result STREQUAL "1")
        message(FATAL_ERROR "${scenario}: expected exit 1, got ${result}\n${output}\n${errors}")
    endif()
    if(NOT errors MATCHES "Failure during Config.lua" OR NOT errors MATCHES "${expected}")
        message(FATAL_ERROR "${scenario}: missing startup diagnostic\n${errors}")
    endif()
    if(scenario STREQUAL "log_fallback" AND NOT errors MATCHES "using stderr")
        message(FATAL_ERROR "Missing logger fallback diagnostic\n${errors}")
    endif()
    if(EXISTS "${work}/data/saves/settings.json")
        message(FATAL_ERROR "${scenario}: failed startup wrote preferences")
    endif()
endforeach()
