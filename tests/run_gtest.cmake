# Preserve the executable and all GoogleTest arguments after the -- separator.
set(command)
set(after_separator FALSE)
set(needs_display FALSE)
math(EXPR last_argument "${CMAKE_ARGC} - 1")
foreach(index RANGE 0 ${last_argument})
    set(argument "${CMAKE_ARGV${index}}")
    if(after_separator)
        list(APPEND command "${argument}")
        if(argument MATCHES "^--gtest_filter=(ShaderGL|FontMetricsGL|FontAtlasGL|SceneGL)\\.")
            set(needs_display TRUE)
        endif()
    elseif(argument STREQUAL "--")
        set(after_separator TRUE)
    endif()
endforeach()

if(NOT command)
    message(FATAL_ERROR "Missing GoogleTest command")
endif()

if(needs_display)
    execute_process(COMMAND "${XVFB_RUN}" -a ${command} RESULT_VARIABLE result)
else()
    execute_process(COMMAND ${command} RESULT_VARIABLE result)
endif()

if(NOT result STREQUAL "0")
    message(FATAL_ERROR "GoogleTest exited with: ${result}")
endif()
